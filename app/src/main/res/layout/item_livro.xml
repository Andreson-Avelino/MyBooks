<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"

    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/background_item_livro"
    android:padding="16dp">

    <TextView
        android:id="@+id/textTituloLivro"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textColor="@color/texto_mybooks"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@id/imageFavorito"
        android:layout_marginEnd="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="O Pequeno Príncipe" />

    <TextView
        android:id="@+id/textAutorLivro"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/texto_mybooks"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textTituloLivro"
        tools:text="Antoine de Saint-Exupéry" />

    <ImageView
        android:id="@+id/imageFavorito"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:contentDescription="@string/favoritos"
        android:padding="4dp"
        android:src="@drawable/selector_favorito"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>