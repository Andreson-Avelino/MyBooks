<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/background_item_livro"
    android:padding="12dp">

    <ImageView
        android:id="@+id/imageCapaBusca"
        android:layout_width="70dp"
        android:layout_height="100dp"
        android:contentDescription="@string/capa_livro"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:src="@mipmap/ic_launcher" />

    <TextView
        android:id="@+id/textTituloBusca"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:textColor="@color/texto_mybooks"
        android:textSize="17sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/imageCapaBusca"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="O Pequeno Príncipe" />

    <TextView
        android:id="@+id/textAutorBusca"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="8dp"
        android:textColor="@color/texto_mybooks"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/imageCapaBusca"
        app:layout_constraintTop_toBottomOf="@id/textTituloBusca"
        tools:text="Antoine de Saint-Exupéry" />

</androidx.constraintlayout.widget.ConstraintLayout>